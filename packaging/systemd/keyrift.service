# Template of the user unit written by `keyrift service install` (spec §9.1).
# The installer replaces the ExecStart path with the absolute path of the installed binary.
[Unit]
Description=Keyrift keyboard remapping engine
After=graphical-session.target

[Service]
ExecStart=/usr/bin/keyrift daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
