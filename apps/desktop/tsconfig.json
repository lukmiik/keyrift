{
  // Two halves with different worlds: the renderer is a web page (DOM, no Node), the rest runs in
  // Node/Electron. Each has its own config so the renderer can't accidentally use Node APIs.
  "files": [],
  // Repeated from tsconfig.web.json for the shadcn CLI, which reads the alias from this file.
  "compilerOptions": { "paths": { "@/*": ["./src/renderer/*"] } },
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }]
}
