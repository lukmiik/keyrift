      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "key": { "$ref": "#/$defs/KeyName" },
            "mods": { "items": { "$ref": "#/$defs/Modifier" }, "type": "array" },
            "type": { "const": "key", "type": "string" }
          },
          "required": ["type", "key"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ms": { "format": "uint32", "minimum": 0, "type": "integer" },
            "type": { "const": "delay", "type": "string" }
          },
          "required": ["type", "ms"],
          "type": "object"
        }
      ]
    },
    "Modifier": {
      "description": "A side-specific modifier.",
      "enum": [
        "LeftCtrl",
        "LeftShift",
        "LeftAlt",
        "LeftSuper",
        "RightCtrl",
        "RightShift",
        "RightAlt",
        "RightSuper"
      ],
      "type": "string"
    },
    "ReleaseHeld": {
      "anyOf": [
        { "$ref": "#/$defs/AllModifiers" },
        { "items": { "$ref": "#/$defs/Modifier" }, "type": "array" }
      ]
    },
    "ShortcutConfig": {
      "additionalProperties": false,
      "properties": {
        "action": { "$ref": "#/$defs/ActionConfig" },
        "trigger": { "$ref": "#/$defs/TriggerConfig" }
      },
      "required": ["trigger", "action"],
      "type": "object"
    },
    "Strategy": {
      "enum": ["permissive-hold", "hold-on-other-press", "timeout-only"],
      "type": "string"
    },
    "TriggerConfig": {
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/KeyName" },
        "mods": { "default": [], "items": { "$ref": "#/$defs/TriggerModifier" }, "type": "array" }
      },
      "required": ["key"],
      "type": "object"
    },
    "TriggerModifier": {
      "description": "A modifier in a shortcut trigger: side-specific or generic (either side).",
      "enum": [
        "LeftCtrl",
        "LeftShift",
        "LeftAlt",
        "LeftSuper",
        "RightCtrl",
        "RightShift",
        "RightAlt",
        "RightSuper",
        "Ctrl",
        "Shift",
        "Alt",
        "Super"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A profile file in `profiles/`.",
  "properties": {
    "$schema": {
      "description": "Optional editor hint pointing at the JSON Schema; ignored by Keyrift.",
      "type": ["string", "null"]
    },
    "layers": {
      "default": [],
      "description": "The first layer is the base layer; at least one layer is required.",
      "items": { "$ref": "#/$defs/LayerConfig" },
      "minItems": 1,
      "type": "array"
    },
    "name": { "default": "", "type": "string" },
    "shortcuts": { "default": [], "items": { "$ref": "#/$defs/ShortcutConfig" }, "type": "array" },
    "version": { "default": 1, "format": "uint32", "minimum": 0, "type": "integer" }
  },
  "title": "Profile",
  "type": "object"
}
