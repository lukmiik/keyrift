{
  "$defs": {
    "ActionConfig": {
      "description": "What a key does (tagged by `type`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Output a key, optionally with modifiers.",
          "properties": {
            "key": { "$ref": "#/$defs/KeyName" },
            "mods": { "items": { "$ref": "#/$defs/Modifier" }, "type": "array" },
            "releaseHeld": {
              "anyOf": [{ "$ref": "#/$defs/ReleaseHeld" }, { "type": "null" }],
              "description": "Held modifiers released while this key is output (\"all\" or a list)."
            },
            "type": { "const": "key", "type": "string" }
          },
          "required": ["type", "key"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Hold a set of modifiers.",
          "properties": {
            "mods": { "items": { "$ref": "#/$defs/Modifier" }, "type": "array" },
            "type": { "const": "mods", "type": "string" }
          },
          "required": ["type", "mods"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Do nothing.",
          "properties": { "type": { "const": "none", "type": "string" } },
          "required": ["type"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Activate a layer.",
          "properties": {
            "layer": { "type": "string" },
            "mode": { "$ref": "#/$defs/LayerMode" },
            "mods": { "items": { "$ref": "#/$defs/Modifier" }, "type": "array" },
            "type": { "const": "layer", "type": "string" }
          },
          "required": ["type", "mode", "layer"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Different actions for tap and hold.",
          "properties": {
            "hold": { "$ref": "#/$defs/ActionConfig" },
            "requirePriorIdleMs": {
              "description": "Typing streak: pressed within this many ms after the previous typing key press,\nthe key is a tap at once. Omit to turn it off.",
              "format": "uint32",
              "minimum": 0,
              "type": ["integer", "null"]
            },
            "strategy": { "anyOf": [{ "$ref": "#/$defs/Strategy" }, { "type": "null" }] },
            "tap": { "$ref": "#/$defs/ActionConfig" },
            "timeoutMs": { "format": "uint32", "minimum": 0, "type": ["integer", "null"] },
            "type": { "const": "tapHold", "type": "string" }
          },
          "required": ["type", "tap", "hold"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Tap a sequence of keys.",
          "properties": {
            "steps": { "items": { "$ref": "#/$defs/MacroStepConfig" }, "type": "array" },
            "type": { "const": "macro", "type": "string" }
          },
          "required": ["type", "steps"],
          "type": "object"
        }
      ]
    },
    "AllModifiers": { "enum": ["all"], "type": "string" },
