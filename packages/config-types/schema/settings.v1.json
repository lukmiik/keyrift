{
  "$defs": {
    "DeviceMatch": {
      "additionalProperties": false,
      "description": "Identifies a keyboard by vendor ID, product ID and name (never by port).",
      "properties": {
        "name": { "type": "string" },
        "productId": { "description": "Hex, e.g. \"0x16d2\".", "type": "string" },
        "vendorId": { "description": "Hex, e.g. \"0x0951\".", "type": "string" }
      },
      "required": ["vendorId", "productId", "name"],
      "type": "object"
    },
    "DeviceSettings": {
      "additionalProperties": false,
      "properties": {
        "excluded": {
          "default": [],
          "description": "Keyboards that are never grabbed.",
          "items": { "$ref": "#/$defs/DeviceMatch" },
          "type": "array"
        },
        "included": {
          "default": [],
          "description": "Hidden devices (e.g. mice with a keyboard interface) that should be grabbed anyway.",
          "items": { "$ref": "#/$defs/DeviceMatch" },
          "type": "array"
        }
      },
      "type": "object"
    },
    "EmergencyRelease": {
      "additionalProperties": false,
      "properties": {
        "enabled": { "default": true, "type": "boolean" },
        "keys": {
          "default": ["KEY_LEFTCTRL", "KEY_SPACE", "KEY_ESC"],
          "description": "Physical keys that, held together, release all keyboards.",
          "items": { "$ref": "#/$defs/KeyName" },
          "type": "array"
        }
      },
      "type": "object"
    },
