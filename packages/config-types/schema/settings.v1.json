    "LogLevel": { "enum": ["error", "warn", "info", "debug"], "type": "string" },
    "Strategy": {
      "enum": ["permissive-hold", "hold-on-other-press", "timeout-only"],
      "type": "string"
    },
    "TapHoldDefaults": {
      "additionalProperties": false,
      "properties": {
        "strategy": { "$ref": "#/$defs/Strategy", "default": "permissive-hold" },
        "timeoutMs": { "default": 200, "format": "uint32", "minimum": 0, "type": "integer" }
      },
      "type": "object"
    },
    "Theme": { "enum": ["system", "light", "dark"], "type": "string" },
    "UiSettings": {
      "additionalProperties": false,
      "description": "Settings used only by the GUI.",
      "properties": {
        "notifyLayerToggle": { "default": true, "type": "boolean" },
        "physicalLayout": { "default": "iso-tkl", "type": "string" },
        "theme": { "$ref": "#/$defs/Theme", "default": "system" }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`settings.json`.",
  "properties": {
    "$schema": {
      "description": "Optional editor hint pointing at the JSON Schema; ignored by Keyrift.",
      "type": ["string", "null"]
    },
    "activeProfile": {
      "default": "default",
      "description": "File name (without `.json`) of the active profile in `profiles/`.",
      "type": "string"
    },
    "devices": { "$ref": "#/$defs/DeviceSettings", "default": { "excluded": [], "included": [] } },
    "emergencyRelease": {
      "$ref": "#/$defs/EmergencyRelease",
      "default": { "enabled": true, "keys": ["KEY_LEFTCTRL", "KEY_SPACE", "KEY_ESC"] }
    },
    "logLevel": { "$ref": "#/$defs/LogLevel", "default": "info" },
    "tapHold": {
      "$ref": "#/$defs/TapHoldDefaults",
      "default": { "strategy": "permissive-hold", "timeoutMs": 200 }
    },
    "ui": {
      "$ref": "#/$defs/UiSettings",
      "default": { "notifyLayerToggle": true, "physicalLayout": "iso-tkl", "theme": "system" }
    },
    "version": { "default": 1, "format": "uint32", "minimum": 0, "type": "integer" }
  },
  "title": "Settings",
  "type": "object"
}
