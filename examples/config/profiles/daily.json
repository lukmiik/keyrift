{
  "$schema": "../schema/profile.v1.json",
  "version": 1,
  "name": "Daily",
  "layers": [
    {
      "id": "base",
      "name": "Base",
      "keys": {
        "KEY_ESC": {
          "type": "key",
          "key": "KEY_CAPSLOCK"
        },
        "KEY_CAPSLOCK": {
          "type": "key",
